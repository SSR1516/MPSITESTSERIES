# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# RAZORPAY CONFIGURATION FOR MPSI TEST SERIES
# Set in AI Studio Secrets panel when switching from Sandbox Test Mode to Live Gateway:
# RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
# RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
# RAZORPAY_PAYMENT_MODE=SANDBOX
